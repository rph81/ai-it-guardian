# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: free key from https://nvd.nist.gov/developers/request-an-api-key makes CVE lookups ~8x faster
NVD_API_KEY=
GUARDIAN_MODEL=claude-opus-5-5
GUARDIAN_EFFORT=medium
GUARDIAN_IFACE=eth0
# Web console (https://<container-ip>:8443). Set to on to require the access code in console/access-code.
GUARDIAN_CONSOLE_AUTH=off
