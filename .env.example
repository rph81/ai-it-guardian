# Non-secret settings, changed from the console (Settings → AI agents). API keys are NOT kept here:
# they are entered in the console and stored encrypted in the vault.
GUARDIAN_MODEL=claude-opus-5-5
GUARDIAN_EFFORT=medium
GUARDIAN_MAX_TURNS=40
GUARDIAN_PARALLEL=3
GUARDIAN_AGENTS_OFF=
# Network interface the scanner uses (ip -br a shows them)
GUARDIAN_IFACE=eth0
