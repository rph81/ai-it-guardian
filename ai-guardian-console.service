[Unit]
Description=AI IT Guardian web console
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/ai-guardian
EnvironmentFile=-/etc/default/ai-guardian
ExecStart=/opt/ai-guardian/venv/bin/python /opt/ai-guardian/console.py
Restart=on-failure
RestartSec=5
UMask=0077
LimitCORE=0
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
